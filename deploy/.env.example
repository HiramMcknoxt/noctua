# Copy to .env and fill in. .env is NEVER committed or shared — it holds
# the only secrets in the system. Everything else is configuration.

# Database + service
NOCTUA_DB=/data/noctua.db
NOCTUA_PORT=8080
RETENTION_DAYS=14
HOLD_DAYS=30

# Camera credentials (referenced from config/cameras.yaml by prefix)
CAM01_USER=
CAM01_PASS=
CAM02_USER=
CAM02_PASS=
CAM03_USER=
CAM03_PASS=
CAM04_USER=
CAM04_PASS=
CAM05_USER=
CAM05_PASS=
CAM06_USER=
CAM06_PASS=
CAM07_USER=
CAM07_PASS=
CAM08_USER=
CAM08_PASS=
CAM09_USER=
CAM09_PASS=

# Witness publication (scripts/publish_witness.sh — now DAILY)
JANUS_URL=http://localhost:8080
WITNESS_REPO=/srv/noctua-witness
CLERK_EMAIL=clerk@cabotar.gov
NOCTUA_AUDIT_KEY=

# Sentinel streaming sink + checkpoints (see README hardening section).
# The sink should live on a Clerk/auditor-controlled mount in production.
NOCTUA_SENTINEL_SINK=/data/sentinel-sink.jsonl
NOCTUA_CHECKPOINTS=/data/noctua.db.checkpoints.jsonl

# Catch-all case-number ban for /search (comma list, substring match).
NOCTUA_BANNED_CASE_PATTERNS=PATROL,TEST,ADMIN,DUTY
