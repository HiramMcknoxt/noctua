res = ch.resolve_sink_divergence()
out = {"marker_intact": open(marker).read() == "FIRST ARCHIVE",
       "archived": (res or {}).get("archived_sink"),
       "marker_name": os.path.basename(marker)}
print(json.dumps(out))
"""


def _v15b_archive_collision(tree):
    rc, out, _raw, err = run_unit(tree, _V15B_CODE)
    ok = (rc == 0 and out and out.get("marker_intact") is True
          and out.get("archived")
          and out.get("archived") != out.get("marker_name"))
    return ok, {"unit": out, "rc": rc, "stderr": err[-200:]}


def _v15c_pending_expiry(tree, side):
    A = Boot(tree, "v15c-%s" % side).start()
    try:
        p = A.port
        s, _b = req(p, "POST", "/hotlist", DET,
                    {"plate": "V15C111", "state": "AR",
                     "category": "felony warrant",
                     "case": "2027-1031"})
        submitted = s
        s, b = req(p, "GET", "/hotlist/pending", SUP)
        rows = b.get("entries") or b.get("pending") or []
        if not rows:
            return False, {"queue_after_submit": b}
        entry_id = rows[0]["id"]
        A.sql("UPDATE hotlist_members SET added_ts="
              "'2026-01-01T00:00:00Z' WHERE rowid=?", (entry_id,))
        s, b = req(p, "GET", "/hotlist/pending", SUP)
        rows_after = b.get("entries") or b.get("pending") or []
        s, _b = req(p, "POST", "/hotlist/approve", SUP,
                    {"id": entry_id})
        approve_status = s
        kinds = audit_kinds(A)
        ok = (submitted == 202 and rows_after == []
              and approve_status == 404
              and "HOTLIST_PENDING_EXPIRED" in kinds)
        return ok, {"submitted": submitted,
                    "queue_after_ageing": rows_after,
                    "approve_expired": approve_status,
                    "expired_chained": "HOTLIST_PENDING_EXPIRED"
                    in kinds}
    finally:
        A.stop()


def _v15d_stranded_cap(tree, side):
    sinkdir = os.path.join(WORK, "v15d-%s" % side)
    shutil.rmtree(sinkdir, ignore_errors=True)
    os.makedirs(sinkdir)
    sink = os.path.join(sinkdir, "sink.log")
    A = Boot(tree, "v15d-%s" % side,
             env_extra={"NOCTUA_SENTINEL_SINK": sink}).start()
    # plain reads chain nothing; supervisor hot-list adds chain
    # one entry each — 60 of them make a chain worth stranding
    for i in range(60):
        req(A.port, "POST", "/hotlist", SUP,
            {"plate": "V15D%03d" % i, "state": "AR",
             "category": "stolen vehicle", "case": "2027-1031"})
    # delivery is a background pass: wait until the mirror
    # actually holds the entries before damaging it
    deadline = time.time() + 60
    while time.time() < deadline:
        try:
            n = sum(1 for _ in open(sink))
        except OSError:
            n = 0
        if n >= 61:
            break
        time.sleep(0.5)
    A.stop()
    # the mirror loses everything past entry 5 while the server
    # is down; the next delivery after reboot names the stranded
    # seqs (56 of them) for the resolution ceremony
    lines = open(sink).read().splitlines()
    with open(sink, "w") as f:
        f.write("\n".join(lines[:5]) + "\n")
    B = Boot(tree, "v15d-%s" % side, dirpath=A.dir,
             env_extra={"NOCTUA_SENTINEL_SINK": sink}).start()
    try:
        req(B.port, "POST", "/hotlist", SUP,
            {"plate": "V15D999", "state": "AR",
             "category": "stolen vehicle", "case": "2027-1031"})
        s, b = req(B.port, "POST", "/audit/sink-divergence-accept",
                   SUP, {})
        accept_status = s
        payloads = audit_payloads(B, "SINK_DIVERGENCE_ACCEPTED")
        pl = payloads[-1] if payloads else {}
        ok = (accept_status == 200
              and len(pl.get("stranded_seqs") or []) <= 50
              and (pl.get("stranded_count") or 0) > 50
              and bool(pl.get("stranded_sha256")))
        return ok, {"accept_status": accept_status,
                    "payload_stranded_len": len(
                        pl.get("stranded_seqs") or []),
                    "payload_count": pl.get("stranded_count")}
    finally:
        B.stop()


def _v15e_escrow_pairing(tree, side):
    d = os.path.join(WORK, "v15e-%s" % side)
    shutil.rmtree(d, ignore_errors=True)
    os.makedirs(d)
    db = os.path.join(d, "janus.db")
    sent = T.load_sentinel(tree)
    env = dict(os.environ)
    env.update({"NOCTUA_DB": db, "NOCTUA_AUDIT_KEY": "v15e-key",
                "NOCTUA_SENTINEL_SINK": os.path.join(d, "sink.log")})
    old_env = dict(os.environ)
    os.environ.update(env)
    try:
        ch = sent.Chain(db)
        ch.append("TEST", {"n": 1})
    finally:
        os.environ.clear()
        os.environ.update(old_env)
    for name in ("users.json", "cases.json", "cameras.json"):
        with open(os.path.join(d, name), "w") as f:
            json.dump({}, f)
    out_root = os.path.join(d, "backups")
    escrow_root = os.path.join(d, "key-escrow")
    os.makedirs(out_root)
    os.makedirs(escrow_root)
    from datetime import datetime, timedelta, timezone
    old_stamp = (datetime.now(timezone.utc)
                 - timedelta(days=40)).strftime("%Y%m%dT%H%M%SZ")
    orphan_stamp = (datetime.now(timezone.utc)
                    - timedelta(days=41)).strftime("%Y%m%dT%H%M%SZ")
    # an archival set retained under a suffixed name, its escrow
    arch_set = os.path.join(out_root,
                            "backup-%s.archived" % old_stamp)
    os.makedirs(arch_set)
    with open(os.path.join(arch_set, "manifest.json"), "w") as f:
        f.write("{}")
    arch_escrow = os.path.join(escrow_root,
                               "key-escrow-%s" % old_stamp)
    os.makedirs(arch_escrow)
    # an escrow whose set is simply gone (prunes on both builds)
    gone_escrow = os.path.join(escrow_root,
                               "key-escrow-%s" % orphan_stamp)
    os.makedirs(gone_escrow)
    benv = dict(os.environ)
    benv.update({"NOCTUA_DB": db, "NOCTUA_AUDIT_KEY": "v15e-key",
                 "NOCTUA_USERS": os.path.join(d, "users.json"),
                 "NOCTUA_CASES": os.path.join(d, "cases.json"),
                 "NOCTUA_CAMERAS": os.path.join(d, "cameras.json"),
                 "NOCTUA_BACKUP_DIR": out_root,
                 "NOCTUA_KEY_ESCROW_DIR": escrow_root,
                 "NOCTUA_SENTINEL_SINK": os.path.join(d, "sink.log")})
    r = subprocess.run(
        [sys.executable, os.path.join(tree, "scripts", "backup.py")],
        env=benv, capture_output=True, text=True, timeout=300)
    ok = (r.returncode == 0 and os.path.isdir(arch_escrow)
          and not os.path.exists(gone_escrow))
    return ok, {"backup_rc": r.returncode,
                "archival_escrow_kept": os.path.isdir(arch_escrow),
                "orphan_escrow_pruned": not os.path.exists(gone_escrow),
                "tail": (r.stdout + r.stderr)[-200:]}


def _v15f_version_residues(tree):
    audit_src = open(os.path.join(
        tree, "scripts", "sentinel_audit.py")).read()
    janus_src = open(os.path.join(tree, "janus.py")).read()
    ok = ('"version": "1.2.7"' in audit_src
          and '"target_schema_version": "1.2.5"' in janus_src)
    return ok, {"sentinel_audit_127": '"version": "1.2.7"' in audit_src,
                "migration_field_renamed":
                '"target_schema_version": "1.2.5"' in janus_src}


def v15_smalls(tree, side):
    """The V15 bundle: (a) checkpoint.py treats a valid-JSON
    non-object final line as truncatable tail; (b) sink archive
    names never collide; (c) undecided submissions expire at 30
    days and cannot be approved afterwards; (d) the divergence
    ceremony chains a bounded stranded summary; (e) an escrow
    prunes only with its paired set — an archivist-retained set
    keeps its escrow, a set-less escrow still prunes; (f) the
    version residues (sentinel_audit's own version; the
    migration stamp's field semantics)."""
    a_ok, a = _v15a_checkpoint_tail(tree)
    b_ok, b = _v15b_archive_collision(tree)
    c_ok, c = _v15c_pending_expiry(tree, side)
    d_ok, dd = _v15d_stranded_cap(tree, side)
    e_ok, e = _v15e_escrow_pairing(tree, side)
    f_ok, f = _v15f_version_residues(tree)
    ok = a_ok and b_ok and c_ok and d_ok and e_ok and f_ok
    return ok, {"checkpoint_tail": a, "archive_collision": b,
                "pending_expiry": c, "stranded_cap": dd,
                "escrow_pairing": e, "version_residues": f}


# ------------------------------------------------------------------
# V16 — sink_divergence() names an unreadable sink (Addendum 1)
# ------------------------------------------------------------------
_V16_CODE = r"""
import json, os, sys
db, sink = os.environ["NOCTUA_DB"], os.environ["NOCTUA_SENTINEL_SINK"]
os.environ.pop("NOCTUA_SENTINEL_SINK", None)
sys.path.insert(0, os.environ["PYTHONPATH"])
import sentinel
ch = sentinel.Chain(db)
for i in range(5):
    ch.append("TEST", {"n": i})
# the mirror's file is non-empty garbage and nothing was ever
# delivered to it (recorded tail 0, file tail 0)
with open(sink, "w") as f:
    f.write("garbage, not json\nmore garbage\n")
os.environ["NOCTUA_SENTINEL_SINK"] = sink
ch2 = sentinel.Chain(db)
out = {"divergence": ch2.sink_divergence()}
print(json.dumps(out))
"""


def v16_sink_unreadable(tree, side):
    """With a non-empty unparseable sink and no delivery ever
    recorded, sink_divergence() returns the divergence — every
    committed seq stranded — so POST
    /audit/sink-divergence-accept can run. (1.2.6 computed
    stranded only for seq <= max(tail, file) = 0, returned None,
    and the ceremony 409'd forever while delivery stayed
    halted.)"""
    rc, out, _raw, err = run_unit(tree, _V16_CODE)
    info = (out or {}).get("divergence") or {}
    ok = (rc == 0 and bool(info)
          and sorted(info.get("stranded_seqs") or []) == [1, 2, 3, 4, 5])
    return ok, {"unit": out, "rc": rc, "stderr": err[-300:]}


# ------------------------------------------------------------------
# V17 — _auth_locked performs no out-of-lock write (Addendum 1)
# ------------------------------------------------------------------
_V17_CODE = r"""
import json, os, sys, time
d = os.path.dirname(os.environ["NOCTUA_DB"])
users = [{"user": "det.okafor", "role": "detective",
          "key_sha256": "x" * 64}]
for name, obj in (("users.json", users),
                  ("cases.json", {"open_cases": ["2027-1001"]}),
                  ("cameras.json", {"cameras": ["CAM-01"]})):
    with open(os.path.join(d, name), "w") as f:
        json.dump(obj, f)
os.environ.update({
    "NOCTUA_USERS": os.path.join(d, "users.json"),
    "NOCTUA_CASES": os.path.join(d, "cases.json"),
    "NOCTUA_CAMERAS": os.path.join(d, "cameras.json"),
    "NOCTUA_PORT": "0"})
sys.path.insert(0, os.environ["PYTHONPATH"])
import janus
user = "det.okafor"
janus._auth_locks[user] = {"fails": 5,
                           "locked_until": time.time() + 900}
janus._auth_lock_persist(user)
q = "SELECT COUNT(*) FROM meta WHERE key=?"
row_before = janus.db.execute(q, ("auth_lock:" + user,)).fetchone()[0]
with open(os.environ["NOCTUA_DB"] + ".provision_marker", "w") as f:
    f.write(json.dumps({"action": "unlock", "user": user}) + "\n")
returned = janus._auth_locked(user)
row_after = janus.db.execute(q, ("auth_lock:" + user,)).fetchone()[0]
out = {"returned": returned, "row_before": row_before,
       "row_after": row_after,
       "in_memory_popped": user not in janus._auth_locks}
print(json.dumps(out))
"""


def v17_auth_locked_no_write(tree, side):
    """A pending shell unlock makes _auth_locked() return False
    and pop the in-memory lock — and the PERSISTED lock row is
    still there afterwards: the read path (which runs outside
    DBLOCK) wrote nothing. (1.2.6 called _auth_lock_persist
    here: DELETE + commit on the shared connection, out of
    lock.)"""
    rc, out, _raw, err = run_unit(tree, _V17_CODE)
    ok = (rc == 0 and out and out.get("returned") is False
          and out.get("in_memory_popped") is True
          and out.get("row_before") == 1
          and out.get("row_after") == 1)
    return ok, {"unit": out, "rc": rc, "stderr": err[-300:]}


# ------------------------------------------------------------------
# V18 — compact.py per-side TOTP secrets (Addendum 1)
# ------------------------------------------------------------------
_V18_CODE = r"""
import importlib.util, io, json, os, sys
os.environ.pop("NOCTUA_TOTP_SECRET", None)
tree = os.environ["PYTHONPATH"]
sys.path.insert(0, tree)
import sentinel
spec = importlib.util.spec_from_file_location(
    "compact_v18", os.path.join(tree, "scripts", "compact.py"))
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
captured = []
class FakeResp:
    def __enter__(self):
        return self
    def __exit__(self, *a):
        return False
    def read(self):
        return b"{}"
def fake_urlopen(req, timeout=None):
    captured.append({k.lower(): v for k, v in req.headers.items()})
    return FakeResp()
mod.urllib.request.urlopen = fake_urlopen
partner = os.environ["NOCTUA_PARTNER_TOTP_SECRET"]
auditor = os.environ["NOCTUA_AUDITOR_TOTP_SECRET"]
mod.http("http://partner", "/compact/checkpoint", "ca.partner",
         "k", totp_secret=mod.PARTNER_TOTP_SECRET)
mod.http("http://ours", "/compact/audit-result", "aud.ours",
         "k", body={"x": 1}, totp_secret=mod.AUDITOR_TOTP_SECRET)
mod.http("http://partner", "/compact/checkpoint-receipt",
         "partner.role", "k", body={"x": 2})
def code(secret):
    return sentinel.totp_code(secret, sentinel.totp_counter_now())
out = {
  "partner_global": mod.PARTNER_TOTP_SECRET,
  "auditor_global": mod.AUDITOR_TOTP_SECRET,
  "partner_header": captured[0].get("x-noctua-totp"),
  "partner_header_ok": captured[0].get("x-noctua-totp") == code(partner),
  "auditor_header_ok": captured[1].get("x-noctua-totp") == code(auditor),
  "sides_differ": captured[0].get("x-noctua-totp")
                  != captured[1].get("x-noctua-totp"),
  "receipt_has_no_totp": "x-noctua-totp" not in captured[2]}
print(json.dumps(out))
"""


def v18_compact_per_side(tree, side):
    """compact.py's two human sides carry DIFFERENT TOTP codes
    (each computed from its own side's secret), and the
    machine-role receipt post carries no TOTP header at all.
    (1.2.6 attached the one global NOCTUA_TOTP_SECRET to every
    call — and has no per-side parameter at all, so this unit
    errors there, which is the defect's shape.)"""
    rc, out, _raw, err = run_unit(
        tree, _V18_CODE,
        env_extra={"NOCTUA_PARTNER_TOTP_SECRET": "JBSWY3DPEHPK3PXP",
                   "NOCTUA_AUDITOR_TOTP_SECRET": "JBSWY3DPEHPK3PXQ"})
    ok = (rc == 0 and out
          and out.get("partner_global") == "JBSWY3DPEHPK3PXP"
          and out.get("auditor_global") == "JBSWY3DPEHPK3PXQ"
          and out.get("partner_header_ok") is True
          and out.get("auditor_header_ok") is True
          and out.get("sides_differ") is True
          and out.get("receipt_has_no_totp") is True)
    return ok, {"unit": out, "rc": rc, "stderr": err[-300:]}


# ------------------------------------------------------------------
# runner
# ------------------------------------------------------------------
CASES_TABLE = [
    ("v1_pickup_lockout", v1_pickup_lockout),
    ("v2_submission_vs_live", v2_submission_vs_live),
    ("v3_sink_mid_damage", v3_sink_mid_damage),
    ("v4_ceremony_state", v4_ceremony_state),
    ("v5_fence_reason_gate", v5_fence_reason_gate),
    ("v5b_fence_atomicity", v5b_fence_atomicity),
    ("v6_restore_unknown", v6_restore_unknown),
    ("v7_registry_prune", v7_registry_prune),
    ("v8_fail_totals_bound", v8_fail_totals_bound),
    ("v9_safety_set", v9_safety_set),
    ("v10_blocked_hit_ref", v10_blocked_hit_ref),
    ("v11_pickup_expiry_scope", v11_pickup_expiry_scope),
    ("v12_users_tmp_unique", v12_users_tmp_unique),
    ("v13_evidence_uniform", v13_evidence_uniform),
    ("v14_probe_retired", v14_probe_retired),
    ("v15_smalls", v15_smalls),
    ("v16_sink_unreadable", v16_sink_unreadable),
    ("v17_auth_locked_no_write", v17_auth_locked_no_write),
    ("v18_compact_per_side", v18_compact_per_side),
]


def run_case(name, fn):
    try:
        test_ok, test_detail = fn(TEST_TREE, "test")
    except Exception as exc:
        test_ok, test_detail = False, {"exception": repr(exc)[:400]}
    try:
        base_ok, base_detail = fn(BASE_TREE, "base")
    except Exception as exc:
        base_ok, base_detail = False, {"exception": repr(exc)[:400]}
    ok = test_ok and not base_ok
    report(name, ok, {"baseline_126": {"ok": base_ok,
                                       "detail": base_detail},
                      "test_127": {"ok": test_ok,
                                   "detail": test_detail},
                      "discriminating": not base_ok})


def main():
    print("V battery: test=%s baseline=%s" % (TEST_TREE, BASE_TREE))
    for name, fn in CASES_TABLE:
        if ONLY and ONLY not in name:
            continue
        run_case(name, fn)
    failed = [n for n, ok in RESULTS if not ok]
    print("=" * 60)
    print("V battery: %d/%d cases pass" % (
        len(RESULTS) - len(failed), len(RESULTS)))
    if failed:
        print("FAILED: %s" % ", ".join(failed))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
